STASH_BASE_URL=https://stash.example.com
STASH_TOKEN=<bearer token>
STASH_PROJECT_KEY=<Your STASH_PROJECT_KEY>
# Optional: comma-separated repo slugs to scope scanning to. Empty = scan every repo in the project above.
STASH_REPO_ALLOWLIST=

JIRA_BASE_URL=https://jira.example.com
JIRA_EMAIL=user@example.com
JIRA_TOKEN=<api token>

POLL_INTERVAL_MINUTES=15
COMMIT_LOOKBACK_DAYS=30
FRONTEND_URL=http://localhost:5173
